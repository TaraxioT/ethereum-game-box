# Copy to .env and fill in. Never commit .env.

# RPC: one Alchemy key with Sepolia and Robinhood Chain mainnet enabled.
ALCHEMY_API_KEY=

# The relayer the Box sends its signed requests to.
RELAYER_URL=http://127.0.0.1:8787

# The Box key: the command that runs the HYP2003 token signer. Unset = a software key (laptops and tests only).
P256_SIGNER_CMD=

# Contract deploys use a cast keystore account, not a key in this file.
DEPLOYER_ACCOUNT=sepolia-deployer
