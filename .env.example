# Copy to .env and fill in. Never commit .env.

# Sepolia RPC (a Chainstack Sepolia node). The URL carries the key: never print or commit it.
SEPOLIA_RPC_URL=
# Etherscan v2 API key, for contract verification and `pnpm names:check`.
ETHERSCAN_API_KEY=

# The relayer the Box sends its signed requests to.
RELAYER_URL=http://127.0.0.1:8787

# The Box key: the command that runs the HYP2003 token signer. Unset = a software key (laptops and tests only).
P256_SIGNER_CMD=

# Contract deploys use a cast keystore account, not a key in this file.
DEPLOYER_ACCOUNT=sepolia-deployer

# The game builder (apps/box/src/builder/README.md).
# Who builds games: claude (the machine's Claude login) or sim (a recorded build replayed, shown SIMULATED).
EGB_FORGE_PROVIDER=claude
# The Designer and the Forge use the Claude Code login; a key here makes the Designer's reads one HTTPS call instead.
ANTHROPIC_API_KEY=
# off: keywords read every answer, no model call.
# EGB_MODEL=off
# Voice: mock (the default; no network, no credits) or elevenlabs (needs the key; spends the free tier's credits under
# the Box's own monthly caps).
EGB_VOICE=mock
ELEVENLABS_API_KEY=
# EGB_VOICE_ID=
# EGB_VOICE_TTS_MAX_CHARS=6000
# EGB_VOICE_STT_MAX_MIN=40

# The ENS names demo (contracts/script/names). No private key goes here: the demo Box's and the agent's P-256 keys
# live only as secrets of the demo Box Worker (apps/demo-box), and every other account signs with a passkey.
# The demo Box's P-256 public key (0x-prefixed 32-byte hex each), from GET /box on the demo Box Worker.
# DEMO_BOX_QX=
# DEMO_BOX_QY=
# The operator's P256Account (the passkey account the operator site shows), which owns mumbai-01.gamebox.eth.
# OPERATOR_ACCOUNT=
