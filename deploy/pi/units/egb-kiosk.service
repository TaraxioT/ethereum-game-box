[Unit]
Description=Ethereum Game Box screen (full-screen Chromium on the Pi's display)
# One full-screen app at a time: the previous Box's screen and the ESP monitor's give way to this one.
Conflicts=gamebox-ui.service esp-monitor-ui.service
After=egb-server.service
Wants=egb-server.service
# A restart of the server (a deploy) reopens the page, so the screen always runs the code the server serves.
PartOf=egb-server.service
# At boot the desktop may not be up yet; keep trying until it is.
StartLimitIntervalSec=0

[Service]
Environment=WAYLAND_DISPLAY=wayland-0
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStartPre=/bin/sh %h/egb/current/deploy/pi/kiosk-prestart.sh
# The screen blanks after 10 idle minutes (swayidle); wake it, ignoring a failure.
ExecStartPre=-/usr/bin/wlopm --on *
# Flags as the Pi's working kiosk runs them. The window flags cover a fresh profile, where kiosk mode alone opened a
# 1050x700 window. --autoplay-policy lets sounds play with no click on the page; --use-fake-ui-for-media-stream grants
# the microphone with no prompt for push-to-talk. Neither touches the Pi's audio devices or volume.
# --enable-wayland-ime with text-input v3 lets a focused text field (the lobby's name) bring up the Pi's touch keyboard
# (squeekboard).
ExecStart=/usr/bin/chromium --kiosk --app=http://127.0.0.1:8790/ \
  --start-fullscreen --window-position=0,0 --window-size=1280,720 \
  --user-data-dir=%h/.config/egb-chromium --password-store=basic \
  --no-first-run --noerrdialogs --disable-infobars --disable-session-crashed-bubble \
  --disable-pinch --overscroll-history-navigation=0 --disable-features=Translate \
  --autoplay-policy=no-user-gesture-required --use-fake-ui-for-media-stream \
  --ozone-platform=wayland --enable-wayland-ime --wayland-text-input-version=3
Restart=always
RestartSec=3
TimeoutStartSec=300
TimeoutStopSec=10

[Install]
WantedBy=default.target
