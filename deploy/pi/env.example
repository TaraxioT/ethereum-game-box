# The Box's settings and secrets. setup.sh copies this file to ~/.config/egb/env (mode 600) once, and never again:
# edit the copy on the Pi. The file is a systemd EnvironmentFile (KEY=value, one per line, # for comments, no `export`),
# read by the server and the screen's units and by the deploy scripts. Never commit a copy with values in it.
# Restart after a change: systemctl --user restart egb-server

# --- The server ---------------------------------------------------------------------------------------------------

# Where the Box keeps its data: the ledger, the badge roster, built games, match transcripts. Deploys never touch it.
# EGB_DATA=~/.local/share/egb   (a systemd file does not expand ~, so write the full path if you set it)

# The port the server listens on, on 127.0.0.1 only. The screen's unit points at 8790: leave it unless you also
# change egb-kiosk.service.
# EGB_PORT=8790

# The tap receiver: the serial device the udev rule names, or `fake` for simulated stations and badges (no hardware).
EGB_RECEIVER=/dev/egb-receiver

# The tap stations' ids, in seat order (Player 1, Player 2). The default is the two stations on the table.
EGB_STATIONS=e4ba70,df3d88

# --- The game builder ---------------------------------------------------------------------------------------------

# Who builds games: claude (the Pi's Claude Code login: run `claude` once as this user) or sim (a recorded build
# replayed, shown SIMULATED on the screen; never a fallback).
EGB_FORGE_PROVIDER=claude

# Set to off to read the Designer's typed and spoken answers by keywords alone (no model call).
# EGB_MODEL=off

# The Forge's model and its time limit per build, in ms.
# FORGE_MODEL=claude-sonnet-5-5
# FORGE_TIMEOUT_MS=480000

# Voice: mock (the default: no microphone needed, no network) or elevenlabs (needs ELEVENLABS_API_KEY below).
EGB_VOICE=mock
# ElevenLabs' voice for the Designer's questions, and the Box's own monthly caps on the free tier's credits.
# EGB_VOICE_ID=
# EGB_VOICE_TTS_MAX_CHARS=6000
# EGB_VOICE_STT_MAX_MIN=40

# --- Secrets (leave empty to run without the feature) -------------------------------------------------------------

# The Game Forge and the Designer: builds games and reads answers with Claude (else the Claude Code login).
ANTHROPIC_API_KEY=

# Voice. Used only with EGB_VOICE=elevenlabs; without a key the voice stays on its mock.
ELEVENLABS_API_KEY=

# --- The updater (egb-update.timer) -------------------------------------------------------------------------------

# The repository to follow, over ssh, and the read-only deploy key it accepts. Until both exist the updater does
# nothing and says so in ~/egb/state/deploy.log.
# EGB_REPO_URL=git@github.com:TaraxioT/ethereum-game-box.git
# EGB_DEPLOY_KEY=/home/pi/.ssh/egb_deploy

# The branch that goes live on the Pi screen.
# EGB_DEPLOY_BRANCH=main

# How long a deploy waits for the Box to be idle (no match running) before it gives up and tries again on the next
# tick, in seconds.
# EGB_IDLE_WAIT=900

# How many releases to keep under ~/egb/releases (the live one and the one before it are always kept).
# EGB_KEEP_RELEASES=5
