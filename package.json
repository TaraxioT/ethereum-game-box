{
  "name": "ethereum-game-box",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "build": "pnpm -r --if-present run build",
    "contracts:install": "cd contracts && forge install --no-git OpenZeppelin/openzeppelin-contracts@v5.7.0 foundry-rs/forge-std@v1.17.0",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts",
    "names:abis": "forge build --root contracts && pnpm --filter @egb/shared abis",
    "names:verify": "node --env-file-if-exists=.env packages/shared/scripts/names/verify.ts",
    "names:check": "node --env-file-if-exists=.env packages/shared/scripts/names/check.ts",
    "plan:publish": "plans publish plan/index.html --name ethereum-game-box --date 2026-11-05",
    "firmware:test": "sh firmware/tap-station/scripts/test.sh",
    "firmware:build": "sh firmware/tap-station/scripts/build.sh",
    "firmware:flash": "sh firmware/tap-station/scripts/flash.sh",
    "taps:bench": "node apps/box/src/taps/bench-cli.ts"
  }
}
